<!DOCTYPE html>
<html>
  <head>
    <title>App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="overflow-x-hidden bg-gray-50">
    <header class="sticky top-0 z-50 bg-white px-6 py-4 shadow-sm">
      <nav class="mb-6 flex flex-col items-stretch gap-3 md:flex-row md:items-center md:justify-between" aria-label="Navegação principal">
        <%= link_to "Resgate e Adote", root_path, class: "text-xl font-bold text-slate-900" %>
        <div class="hidden md:flex items-center space-x-4">
          <% if current_user.present? %>
            <%= link_to "Painel Administrativo", admin_animals_path, class: "text-sm font-semibold text-slate-700 transition hover:text-rose-600" %>
            <%= link_to "Meu Perfil", edit_admin_profile_path, class: "text-sm font-semibold text-slate-700 transition hover:text-rose-600" %>
            <% if current_user.superadmin? %>
              <%= link_to "Gerenciar Voluntários", admin_users_path, class: "text-sm font-semibold text-slate-700 transition hover:text-rose-600" %>
            <% end %>
            <%= link_to "Sair", logout_path, class: "rounded-lg bg-gray-100 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-gray-200" %>
          <% else %>
            <%= link_to "Área do Voluntário", login_path, class: "text-sm font-medium text-slate-600 transition hover:text-rose-600" %>
          <% end %>
        </div>

        <details class="relative block md:hidden">
          <summary aria-label="Abrir menu" class="flex cursor-pointer list-none justify-end rounded-lg p-2 text-slate-700 hover:bg-gray-100 [&::-webkit-details-marker]:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </summary>
          <div class="flex w-full flex-col space-y-2 border-t border-gray-100 pb-2 pt-4">
            <% if current_user.present? %>
              <%= link_to "Painel Administrativo", admin_animals_path, class: "rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-gray-50" %>
              <%= link_to "Meu Perfil", edit_admin_profile_path, class: "rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-gray-50" %>
              <% if current_user.superadmin? %>
                <%= link_to "Gerenciar Voluntários", admin_users_path, class: "rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-gray-50" %>
              <% end %>
              <%= link_to "Sair", logout_path, class: "rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-gray-50" %>
            <% else %>
              <%= link_to "Área do Voluntário", login_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50" %>
            <% end %>
          </div>
        </details>
      </nav>
    </header>

    <main>
      <% if flash.any? %>
        <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
          <% flash.each do |type, message| %>
            <% next if message.blank? %>
            <% if type.to_s == "notice" %>
              <div role="status" class="bg-green-50 border-l-4 border-green-400 p-4 mb-6 shadow-sm text-sm text-green-700"><%= message %></div>
            <% elsif type.to_s == "alert" %>
              <div role="alert" class="bg-red-50 border-l-4 border-red-400 p-4 mb-6 shadow-sm text-sm text-red-700"><%= message %></div>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
