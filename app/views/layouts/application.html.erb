<!DOCTYPE html>
<html>
  <head>
    <title>App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag asset_path("logo.jfif") %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="overflow-x-hidden bg-gray-50">
    <header class="sticky top-0 z-50 border-b border-gray-100 bg-white px-6 py-4">
      <nav class="mb-6 flex flex-col items-stretch gap-3 md:flex-row md:items-center md:justify-between" aria-label="Navegação principal">
        <%= link_to root_path do %>
          <%= image_tag "logo.jfif", alt: "Resgate & Adote", class: "h-10 w-auto object-contain md:h-12" %>
        <% end %>
        <div class="hidden md:flex items-center space-x-4">
          <% if current_user.present? %>
            <%= link_to "Painel Administrativo", admin_animals_path, class: "text-sm font-semibold text-slate-700 transition hover:text-[#00A884]" %>
            <%= link_to "Meu Perfil", edit_admin_profile_path, class: "text-sm font-semibold text-slate-700 transition hover:text-[#00A884]" %>
            <% if current_user.superadmin? %>
              <%= link_to "Gerenciar Voluntários", admin_users_path, class: "text-sm font-semibold text-slate-700 transition hover:text-[#00A884]" %>
            <% end %>
            <%= link_to "Sair", logout_path, class: "rounded-lg bg-gray-100 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-gray-200" %>
          <% else %>
            <%= link_to "Área do Voluntário", login_path, class: "text-sm font-medium text-slate-600 transition hover:text-[#00A884]" %>
          <% end %>
        </div>

        <details class="relative block md:hidden">
          <summary aria-label="Abrir menu" class="flex cursor-pointer list-none justify-end rounded-lg p-2 text-slate-700 hover:bg-gray-100 [&::-webkit-details-marker]:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </summary>
          <div class="flex w-full flex-col space-y-2 border-t border-gray-100 pb-2 pt-4">
            <% if current_user.present? %>
              <%= link_to "Painel Administrativo", admin_animals_path, class: "rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-gray-50 hover:text-[#00A884]" %>
              <%= link_to "Meu Perfil", edit_admin_profile_path, class: "rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-gray-50 hover:text-[#00A884]" %>
              <% if current_user.superadmin? %>
                <%= link_to "Gerenciar Voluntários", admin_users_path, class: "rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-gray-50 hover:text-[#00A884]" %>
              <% end %>
              <%= link_to "Sair", logout_path, class: "rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-gray-50" %>
            <% else %>
              <%= link_to "Área do Voluntário", login_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 hover:text-[#00A884]" %>
            <% end %>
          </div>
        </details>
      </nav>
    </header>

    <main>
      <% if flash.any? %>
        <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
          <% flash.each do |type, message| %>
            <% next if message.blank? %>
            <% if type.to_s == "notice" %>
              <div role="status" class="bg-green-50 border-l-4 border-green-400 p-4 mb-6 shadow-sm text-sm text-green-700"><%= message %></div>
            <% elsif type.to_s == "alert" %>
              <div role="alert" class="bg-red-50 border-l-4 border-red-400 p-4 mb-6 shadow-sm text-sm text-red-700"><%= message %></div>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="mt-16 border-t border-gray-200 bg-gray-50 py-8">
      <% social_links = { "Instagram" => ENV["INSTAGRAM_URL"], "Facebook" => ENV["FACEBOOK_URL"] }.select { |_name, url| url.present? } %>
      <div class="mx-auto flex max-w-7xl flex-col items-center gap-4 px-4 text-center sm:px-6 lg:px-8">
        <%= link_to root_path, aria: { label: "Resgate & Adote — página inicial" } do %>
          <%= image_tag "logo.jfif", alt: "Resgate & Adote", class: "h-8 w-auto object-contain" %>
        <% end %>
        <p class="text-sm text-gray-600">Resgate &amp; Adote © 2026 — Conectando animais resgatados a lares cheios de amor.</p>

        <nav aria-label="Redes sociais" class="flex items-center gap-3">
          <% if social_links["Instagram"].present? %>
            <%= link_to social_links["Instagram"], target: "_blank", rel: "noopener noreferrer", aria: { label: "Instagram" }, class: "inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-600 transition hover:border-[#00A884] hover:text-[#00A884]" do %>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke-width="2" />
                <circle cx="12" cy="12" r="4" stroke-width="2" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            <% end %>
          <% else %>
            <span title="Configure INSTAGRAM_URL para ativar o link" aria-label="Instagram" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-400">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke-width="2" />
                <circle cx="12" cy="12" r="4" stroke-width="2" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            </span>
          <% end %>

          <% if social_links["Facebook"].present? %>
            <%= link_to social_links["Facebook"], target: "_blank", rel: "noopener noreferrer", aria: { label: "Facebook" }, class: "inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-600 transition hover:border-[#00A884] hover:text-[#00A884]" do %>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.5 1.6-1.5h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V21h3.4Z" />
              </svg>
            <% end %>
          <% else %>
            <span title="Configure FACEBOOK_URL para ativar o link" aria-label="Facebook" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-400">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.5 1.6-1.5h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V21h3.4Z" />
              </svg>
            </span>
          <% end %>
        </nav>

        <%= link_to(current_user.present? ? admin_animals_path : login_path, class: "inline-flex min-h-10 items-center justify-center rounded-lg bg-[#00A884] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[#008f6f] focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2") do %>
          <%= current_user.present? ? "Acessar painel voluntário" : "Área do Voluntário" %>
        <% end %>
      </div>
    </footer>
  </body>
</html>
