<!DOCTYPE html>
<html>
  <head>
    <title>App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-gray-50">
    <header class="fixed inset-x-0 top-0 z-50 bg-white px-6 py-4 shadow-sm">
      <nav class="flex items-center justify-between" aria-label="Navegação principal">
        <%= link_to "Resgate e Adote", root_path, class: "text-xl font-bold text-slate-900" %>
        <div class="flex items-center gap-3 sm:gap-6">
          <% if current_user.present? %>
            <%= link_to "Painel Administrativo", admin_animals_path, class: "text-sm font-semibold text-slate-700 transition hover:text-rose-600 sm:text-base" %>
            <%= link_to "Meu Perfil", edit_admin_profile_path, class: "text-sm font-semibold text-slate-700 transition hover:text-rose-600 sm:text-base" %>
            <% if current_user.superadmin? %>
              <%= link_to "Gerenciar Voluntários", admin_users_path, class: "text-sm font-semibold text-slate-700 transition hover:text-rose-600 sm:text-base" %>
            <% end %>
            <%= link_to "Sair", logout_path, class: "rounded-lg bg-gray-100 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-gray-200" %>
          <% else %>
            <%= link_to "Área do Voluntário", login_path, class: "text-sm font-medium text-slate-600 transition hover:text-rose-600 sm:text-base" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="pt-20">
      <% if flash.any? %>
        <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
          <% flash.each do |type, message| %>
            <% next if message.blank? %>
            <% if type.to_s == "notice" %>
              <div role="status" class="bg-green-50 border-l-4 border-green-400 p-4 mb-6 shadow-sm text-sm text-green-700"><%= message %></div>
            <% elsif type.to_s == "alert" %>
              <div role="alert" class="bg-red-50 border-l-4 border-red-400 p-4 mb-6 shadow-sm text-sm text-red-700"><%= message %></div>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
