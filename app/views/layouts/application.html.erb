<!DOCTYPE html>
<html>
  <head>
    <title>App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-gray-50">
    <header class="fixed inset-x-0 top-0 z-50 bg-white px-6 py-4 shadow-sm">
      <nav class="flex items-center justify-between" aria-label="Navegação principal">
        <%= link_to "Resgate e Adote", root_path, class: "text-xl font-bold text-slate-900" %>
        <div class="flex items-center gap-3 sm:gap-6">
          <% if current_user.present? %>
            <%= link_to "Painel Administrativo", admin_animals_path, class: "text-sm font-semibold text-slate-700 transition hover:text-rose-600 sm:text-base" %>
            <%= link_to "Sair", logout_path, class: "rounded-lg bg-gray-100 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-gray-200" %>
          <% else %>
            <%= link_to "Área do Voluntário", login_path, class: "text-sm font-medium text-slate-600 transition hover:text-rose-600 sm:text-base" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="pt-20">
      <%= yield %>
    </main>
  </body>
</html>
