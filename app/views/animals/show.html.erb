<main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <nav aria-label="Breadcrumb" class="mb-6 text-sm text-gray-500">
    <ol class="flex flex-wrap items-center gap-2">
      <li><%= link_to "Home", root_path, class: "transition hover:text-rose-600" %></li>
      <li aria-hidden="true">&gt;</li>
      <li><%= link_to "Animais para adoção", animals_path, class: "transition hover:text-rose-600" %></li>
      <li aria-hidden="true">&gt;</li>
      <li class="font-medium text-gray-700" aria-current="page"><%= @animal.name %></li>
    </ol>
  </nav>

  <%
    phone_number = @animal.user&.phone.to_s.gsub(/\D/, "")
    whatsapp_message = "Olá! Vi o(a) #{@animal.name} no Resgate e Adote e quero saber mais sobre a adoção."
    whatsapp_url = "https://wa.me/#{phone_number}?text=#{ERB::Util.url_encode(whatsapp_message)}"
    adoption_title = @animal.female? ? "Quero Adotar a #{@animal.name}" : (@animal.male? ? "Quero Adotar o #{@animal.name}" : "Quero Adotar #{@animal.name}")
  %>

  <section class="grid grid-cols-1 gap-12 lg:grid-cols-2" aria-labelledby="animal-name">
    <div>
      <% if @animal.photos.attached? %>
        <%= image_tag @animal.photos.first, alt: "Foto de #{@animal.name}", class: "w-full aspect-[4/3] sm:aspect-square object-cover rounded-2xl shadow-xl" %>
        <% if @animal.photos.count > 1 %>
          <div class="grid grid-cols-2 gap-4 mt-4">
            <% @animal.photos.drop(1).first(2).each_with_index do |photo, index| %>
              <%= image_tag photo, alt: "Foto #{index + 2} de #{@animal.name}", class: "rounded-xl object-cover aspect-video sm:aspect-square" %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="flex w-full aspect-[4/5] flex-col items-center justify-center gap-3 rounded-3xl bg-rose-50 text-rose-300 shadow-xl">
          <span class="text-7xl" aria-hidden="true">🐾</span>
          <span class="font-medium text-gray-600">Foto em breve</span>
        </div>
      <% end %>
    </div>

    <div class="flex flex-col items-start">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-rose-400"><%= @animal.cat? ? "Gatinho" : (@animal.dog? ? "Cachorrinho" : "Pet") %> à procura de um lar</p>
      <h1 id="animal-name" class="mb-6 text-5xl font-extrabold uppercase tracking-tight text-rose-600 lg:text-6xl"><%= @animal.name %></h1>

      <div class="mb-7 flex flex-wrap gap-2" aria-label="Características de #{@animal.name}">
        <span class="mb-2 rounded-full bg-rose-50 px-4 py-1 text-sm font-medium text-rose-700"><%= @animal.male? ? "Macho" : (@animal.female? ? "Fêmea" : "Sexo não informado") %></span>
        <span class="mb-2 rounded-full bg-rose-50 px-4 py-1 text-sm font-medium text-rose-700"><%= { "small" => "Porte pequeno", "medium" => "Porte médio", "large" => "Porte grande" }[@animal.size] || "Porte não informado" %></span>
        <span class="mb-2 rounded-full bg-rose-50 px-4 py-1 text-sm font-medium text-rose-700"><%= @animal.age.presence || "Idade não informada" %></span>
        <% if [@animal.city, @animal.state].any?(&:present?) %>
          <span class="mb-2 rounded-full bg-rose-50 px-4 py-1 text-sm font-medium text-rose-700"><%= [@animal.city, @animal.state].compact_blank.join("/") %></span>
        <% end %>
      </div>

      <section class="mb-8 w-full">
        <h2 class="mb-3 text-xl font-bold text-gray-800">A história de <%= @animal.name %></h2>
        <p class="text-lg leading-relaxed text-gray-700"><%= @animal.description.presence || "Toda adoção começa com um encontro. Venha conhecer #{@animal.name} e descobrir se vocês foram feitos um para o outro." %></p>
      </section>

      <% if @animal.temperament.present? %>
        <section class="mb-8 w-full rounded-2xl bg-gray-50 p-5">
          <h2 class="mb-2 text-lg font-bold text-gray-800">Personalidade</h2>
          <p class="leading-relaxed text-gray-700"><%= @animal.temperament %></p>
        </section>
      <% end %>

      <section class="mb-8 grid w-full grid-cols-3 gap-3" aria-label="Uma nova história de adoção">
        <div class="rounded-2xl bg-rose-50/70 p-4 text-center">
          <span class="text-2xl" aria-hidden="true">🐾</span>
          <p class="mt-2 text-sm font-semibold text-gray-600">Um pet único</p>
        </div>
        <div class="rounded-2xl bg-amber-50 p-4 text-center">
          <span class="text-2xl" aria-hidden="true">🏡</span>
          <p class="mt-2 text-sm font-semibold text-gray-600">Um novo lar</p>
        </div>
        <div class="rounded-2xl bg-orange-50 p-4 text-center">
          <span class="text-2xl" aria-hidden="true">💛</span>
          <p class="mt-2 text-sm font-semibold text-gray-600">Companheirismo</p>
        </div>
      </section>

      <% if @animal.health_status.present? %>
        <section class="mb-8 w-full rounded-2xl border border-emerald-100 bg-emerald-50 p-5">
          <h2 class="font-bold text-gray-800">Saúde e cuidados</h2>
          <p class="mt-2 leading-relaxed text-gray-700"><%= @animal.health_status %></p>
        </section>
      <% end %>

      <div id="adocao" class="mt-auto w-full rounded-3xl bg-rose-50 p-5 sm:p-6">
        <p class="mb-2 font-semibold text-gray-800">Pronto para começar uma nova história?</p>
        <% if phone_number.present? %>
          <%= link_to whatsapp_url, target: "_blank", rel: "noopener noreferrer", class: "inline-flex w-full items-center justify-center rounded-full bg-rose-500 px-10 py-4 text-xl font-bold text-white shadow-lg transition-transform transform hover:-translate-y-1 hover:bg-rose-600 hover:shadow-2xl sm:w-auto" do %>
            <span class="mr-2" aria-hidden="true">🐾</span>
            <%= adoption_title %>
          <% end %>
          <p class="mt-3 text-sm text-gray-600">Vamos abrir uma conversa no WhatsApp com a pessoa responsável.</p>
        <% else %>
          <%= link_to adoption_title, "#instrucoes-adocao", class: "inline-flex w-full items-center justify-center rounded-full bg-rose-500 px-10 py-4 text-xl font-bold text-white shadow-lg transition-transform transform hover:-translate-y-1 hover:bg-rose-600 hover:shadow-2xl sm:w-auto" %>
          <p class="mt-3 text-sm text-gray-600">Confira abaixo como seguir com o processo de adoção.</p>
        <% end %>
      </div>
    </div>
  </section>

  <section id="instrucoes-adocao" class="mt-12 rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
    <h2 class="text-2xl font-bold text-gray-800">Como funciona a adoção?</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-gray-700">Entre em contato com a equipe responsável para conversar sobre a rotina, os cuidados e os próximos passos. A adoção é um compromisso para a vida toda e queremos ajudar vocês a começarem essa história com carinho.</p>
    <% if phone_number.present? %>
      <%= link_to "Conversar sobre a adoção", whatsapp_url, target: "_blank", rel: "noopener noreferrer", class: "mt-5 inline-flex rounded-xl border border-amber-300 bg-white px-5 py-3 font-semibold text-amber-900 transition hover:bg-amber-100 focus:outline-none focus:ring-2 focus:ring-amber-300" %>
    <% end %>
  </section>
</main>
