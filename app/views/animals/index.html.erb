<main class="mx-auto w-full max-w-7xl space-y-8 px-4 py-8 sm:px-6 lg:px-8">
  <section class="bg-gradient-to-r from-rose-50 to-emerald-50 dark:from-gray-800 dark:to-gray-800 p-6 sm:p-10 rounded-3xl mb-8 border border-rose-100/50 dark:border-gray-700 text-center shadow-sm">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white mb-3">Encontre seu novo melhor amigo 🐾</h1>
    <p class="text-gray-600 dark:text-gray-300 text-base sm:text-lg max-w-2xl mx-auto">Conectamos animais resgatados a famílias amorosas. Escolha um pet e fale diretamente com o responsável pelo WhatsApp!</p>
  </section>

  <section aria-label="Filtros de animais" class="mb-6 w-full rounded-3xl bg-rose-50 p-4 sm:p-5 dark:bg-gray-800">
    <% current_species = params[:species].presence_in(Animal.species.keys) %>
    <details id="animal-filters" class="group">
      <summary class="mb-3 flex cursor-pointer list-none items-center justify-between rounded-2xl bg-rose-50 px-4 py-3 font-bold text-rose-700 marker:hidden md:hidden dark:bg-gray-700 dark:text-rose-200">
        🔍 Filtrar Animais <span class="text-xs font-normal">Expandir ↓</span>
      </summary>
      <nav aria-label="Filtrar por espécie" class="flex flex-wrap gap-2">
      <% [["Todos", nil], ["🐱 Gatos", "cat"], ["🐶 Cachorros", "dog"]].each do |label, species| %>
        <% selected = current_species == species || (species.nil? && current_species.blank?) %>
        <%= link_to label, animals_path(request.query_parameters.except("species").merge(species: species).compact_blank), class: "rounded-full px-4 py-2 text-sm font-semibold transition focus:outline-none focus:ring-2 focus:ring-rose-400 #{selected ? 'bg-[#E60067] text-white shadow-sm' : 'bg-white text-rose-700 hover:bg-rose-100 dark:bg-gray-700 dark:text-rose-200 dark:hover:bg-gray-600'}" %>
      <% end %>
      </nav>

      <%= form_with url: animals_path, method: :get, local: true, class: "mt-4 flex flex-col gap-4" do |form| %>
      <% if current_species.present? %>
        <%= form.hidden_field :species, value: current_species %>
      <% end %>
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-rose-900 dark:text-rose-200">Porte</p>
        <div class="flex flex-wrap gap-2">
          <% [["Todos", ""], ["Pequeno", "small"], ["Médio", "medium"], ["Grande", "large"]].each_with_index do |(label, value), index| %>
            <% input_id = "animal_size_filter_#{index}" %>
            <% selected = params[:size].to_s == value %>
            <label for="<%= input_id %>" class="cursor-pointer">
              <%= form.radio_button :size, value, id: input_id, checked: selected, class: "peer sr-only" %>
              <span class="inline-flex items-center rounded-full px-4 py-2 text-sm transition peer-focus-visible:ring-2 peer-focus-visible:ring-[#E60067] <%= selected ? 'bg-[#E60067] text-white font-bold' : 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200' %>"><%= label %></span>
            </label>
          <% end %>
        </div>
      </div>
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-rose-900 dark:text-rose-200">Sexo</p>
        <div class="flex flex-wrap gap-2">
          <% [["Todos", ""], ["♂ Macho", "male"], ["♀ Fêmea", "female"]].each_with_index do |(label, value), index| %>
            <% input_id = "animal_sex_filter_#{index}" %>
            <% selected = params[:sex].to_s == value %>
            <label for="<%= input_id %>" class="cursor-pointer">
              <%= form.radio_button :sex, value, id: input_id, checked: selected, class: "peer sr-only" %>
              <span class="inline-flex items-center rounded-full px-4 py-2 text-sm transition peer-focus-visible:ring-2 peer-focus-visible:ring-[#E60067] <%= selected ? 'bg-[#E60067] text-white font-bold' : 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200' %>"><%= label %></span>
            </label>
          <% end %>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <%= form.submit "Filtrar pets", class: "inline-flex cursor-pointer justify-center rounded-full bg-[#E60067] px-5 py-2.5 text-sm font-bold text-white transition hover:bg-[#c40057] focus:outline-none focus:ring-2 focus:ring-rose-400 focus:ring-offset-2 focus:ring-offset-rose-50" %>
        <%= link_to "Limpar filtros", root_path, class: "ml-2 text-xs text-gray-500 underline" if params[:species].present? || params[:size].present? || params[:sex].present? %>
      </div>
      <% end %>
    </details>
    <script>
      (() => {
        const filters = document.getElementById("animal-filters");
        const mobile = window.matchMedia("(max-width: 767px)");
        const syncFilters = () => { filters.open = !mobile.matches; };
        syncFilters();
        mobile.addEventListener("change", syncFilters);
      })();
    </script>
  </section>

  <% if @animals.any? %>
    <section aria-label="Pets disponíveis para adoção" class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% @animals.each do |animal| %>
        <%= link_to animal_path(animal), class: "group flex h-auto flex-row overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-all hover:shadow-md focus:outline-none focus:ring-4 focus:ring-rose-300 dark:border-gray-700/60 dark:bg-gray-800 md:h-full md:flex-col" do %>
          <div class="relative aspect-square w-36 flex flex-shrink-0 items-center justify-center overflow-hidden rounded-l-2xl bg-gray-100 p-1 sm:w-44 md:w-full dark:bg-gray-800">
            <% if animal.photos.attached? %>
              <%= image_tag animal.photos.first, alt: "Foto de #{animal.name}", class: "h-full w-full object-contain" %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center bg-rose-100 text-5xl text-rose-300 dark:bg-gray-700" aria-label="Foto não disponível">
                <span aria-hidden="true">🐾</span>
              </div>
            <% end %>

            <% if animal.created_at >= 7.days.ago %>
              <span class="absolute bottom-1 left-1 z-10 rounded-md bg-rose-600/90 px-1.5 py-0.5 text-[10px] font-bold text-white">Chegou agora</span>
            <% end %>

            <span class="absolute right-1 top-1 z-10 inline-flex items-center justify-center rounded-full bg-gray-500/70 p-1.5" aria-label="<%= animal.female? ? 'Fêmea' : (animal.male? ? 'Macho' : 'Sexo não informado') %>">
              <% if animal.female? %>
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/90 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="8" r="5" />
                  <path stroke-linecap="round" d="M12 13v8m-3-3h6" />
                </svg>
              <% elsif animal.male? %>
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/90 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="10" cy="14" r="6" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.5 9.5 6-6m-5 0h5v5" />
                </svg>
              <% else %>
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/90 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c-2 3-6 6.5-6 11a6 6 0 0 0 12 0c0-4.5-4-8-6-11Z" />
                </svg>
              <% end %>
            </span>
          </div>

          <div class="flex min-w-0 flex-grow flex-col justify-between p-3 sm:p-4">
            <div class="min-w-0">
              <h3 class="truncate text-base font-bold text-[#E60067] dark:text-rose-400 sm:text-lg"><%= animal.name %></h3>
              <p class="mb-2 mt-1 line-clamp-2 text-xs text-gray-600 dark:text-gray-300 sm:text-sm"><%= animal.description.presence || animal.temperament.presence || "Um novo amigo está esperando para conhecer você." %></p>
            </div>
            <div class="mt-auto flex flex-wrap gap-1 text-[11px] font-semibold text-gray-500 dark:text-gray-400">
              <span class="rounded-md px-2 py-0.5 <%= animal.cat? ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300' : 'bg-rose-50 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300' %>"><%= animal.species == 'cat' ? '🐱 Gato' : '🐶 Cão' %></span>
              <span class="rounded-md bg-gray-100 px-2 py-0.5 dark:bg-gray-700"><%= animal.age.present? ? localized_animal_age(animal.age) : "Idade desconhecida" %></span>
              <% if animal.size.present? %>
                <span class="rounded-md bg-gray-100 px-2 py-0.5 dark:bg-gray-700"><%= { "small" => "Pequeno", "medium" => "Médio", "large" => "Grande" }[animal.size] %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <section class="mx-auto max-w-lg rounded-3xl border border-rose-100 bg-white px-6 py-12 text-center shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <p class="text-5xl" aria-hidden="true">🐾</p>
      <h2 class="mt-4 text-xl font-bold text-slate-800 dark:text-gray-100">Nenhum pet encontrado</h2>
      <p class="mt-2 text-slate-600 dark:text-gray-300">Tente ajustar os filtros para conhecer outros animais.</p>
      <%= link_to "Limpar filtros", animals_path, class: "mt-6 inline-flex rounded-xl bg-[#E60067] px-5 py-3 font-semibold text-white transition hover:bg-[#c40057]" %>
    </section>
  <% end %>
</main>
