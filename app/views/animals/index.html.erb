<main class="mx-auto w-full max-w-7xl space-y-8 px-4 py-8 sm:px-6 lg:px-8">
  <header class="border-b border-rose-100 pb-6">
    <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-rose-500">Um lar cheio de carinho começa aqui</p>
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-800 sm:text-4xl">Encontre seu novo melhor amigo <span aria-hidden="true">🐾</span></h1>
    <p class="mt-2 text-slate-600">Conheça os pets que estão esperando por uma família.</p>
  </header>

  <section aria-label="Filtros de animais" class="w-full rounded-3xl bg-rose-50 p-4 sm:p-5">
    <% current_species = params[:species].presence_in(Animal.species.keys) %>
    <nav aria-label="Filtrar por espécie" class="flex flex-wrap gap-2">
      <% [["Todos", nil], ["🐱 Gatos", "cat"], ["🐶 Cachorros", "dog"]].each do |label, species| %>
        <% selected = current_species == species || (species.nil? && current_species.blank?) %>
        <%= link_to label, animals_path(request.query_parameters.except("species").merge(species: species).compact_blank), class: "rounded-full px-4 py-2 text-sm font-semibold transition focus:outline-none focus:ring-2 focus:ring-rose-400 #{selected ? 'bg-rose-500 text-white shadow-sm' : 'bg-white text-rose-700 hover:bg-rose-100'}" %>
      <% end %>
    </nav>

    <%= form_with url: animals_path, method: :get, local: true, class: "mt-4 flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
      <% if current_species.present? %>
        <%= form.hidden_field :species, value: current_species %>
      <% end %>
      <div class="w-full sm:max-w-xs">
        <%= form.label :size, "Porte", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-rose-900" %>
        <%= form.select :size, [["Todos os portes", ""], ["Pequeno", "small"], ["Médio", "medium"], ["Grande", "large"]], { selected: params[:size] }, class: "w-full rounded-full border border-rose-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-200" %>
      </div>
      <div class="w-full sm:max-w-xs">
        <%= form.label :sex, "Sexo", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-rose-900" %>
        <%= form.select :sex, [["Todos", ""], ["Fêmea", "female"], ["Macho", "male"]], { selected: params[:sex] }, class: "w-full rounded-full border border-rose-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-200" %>
      </div>
      <%= form.submit "Filtrar pets", class: "inline-flex cursor-pointer justify-center rounded-full bg-rose-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-400 focus:ring-offset-2 focus:ring-offset-rose-50" %>
    <% end %>
  </section>

  <% if @animals.any? %>
    <section aria-label="Pets disponíveis para adoção" class="grid grid-cols-1 gap-6 p-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      <% @animals.each do |animal| %>
        <%= link_to animal_path(animal), class: "group relative block overflow-hidden rounded-2xl bg-slate-200 shadow-md focus:outline-none focus:ring-4 focus:ring-rose-300" do %>
          <% if animal.photos.attached? %>
            <%= image_tag animal.photos.first, alt: "Foto de #{animal.name}", class: "aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-110" %>
          <% else %>
            <div class="flex aspect-[4/5] w-full items-center justify-center bg-rose-100 text-6xl text-rose-300 transition-transform duration-500 group-hover:scale-110" aria-label="Foto não disponível">
              <span aria-hidden="true">🐾</span>
            </div>
          <% end %>

          <% if animal.created_at >= 7.days.ago %>
            <span class="absolute left-3 top-3 rounded-full bg-white px-3 py-1 text-xs font-bold text-rose-600 shadow">Chegou agora</span>
          <% end %>

          <div class="absolute bottom-0 w-full bg-gradient-to-t from-black/90 via-black/40 to-transparent p-4 pt-16">
            <h2 class="text-2xl font-bold text-white"><%= animal.name %></h2>
            <p class="mt-1 text-sm font-medium text-white/90">
              <%= [animal.male? ? "Macho" : (animal.female? ? "Fêmea" : nil), animal.age.presence].compact.join(" • ").presence || "Pronto para conhecer você" %>
            </p>
          </div>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <section class="mx-auto max-w-lg rounded-3xl border border-rose-100 bg-white px-6 py-12 text-center shadow-sm">
      <p class="text-5xl" aria-hidden="true">🐾</p>
      <h2 class="mt-4 text-xl font-bold text-slate-800">Nenhum pet encontrado</h2>
      <p class="mt-2 text-slate-600">Tente ajustar os filtros para conhecer outros animais.</p>
      <%= link_to "Limpar filtros", animals_path, class: "mt-6 inline-flex rounded-xl bg-rose-500 px-5 py-3 font-semibold text-white transition hover:bg-rose-600" %>
    </section>
  <% end %>
</main>
