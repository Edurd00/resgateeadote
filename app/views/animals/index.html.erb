<h1>Vitrine de Pets para Adoção</h1>

<div>
  <strong>Filtrar por espécie:</strong>
  <%= link_to "Todos", animals_path %> |
  <%= link_to "Gatos", animals_path(species: "cat") %> |
  <%= link_to "Cachorros", animals_path(species: "dog") %>
</div>

<div class="animals-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; margin-top: 20px;">
  <% @animals.each do |animal| %>
    <div class="animal-card" style="border: 1px solid #ccc; padding: 15px; border-radius: 8px;">
      <div class="animal-photo">
        <% if animal.photos.attached? %>
          <%= image_tag animal.photos.first, style: "width: 100%; height: 200px; object-fit: cover; border-radius: 4px;" %>
        <% else %>
          <div style="width: 100%; height: 200px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; border-radius: 4px;">Sem foto</div>
        <% end %>
      </div>
      <h3><%= link_to animal.name, animal_path(animal) %></h3>
      <p><strong>Idade:</strong> <%= animal.age %></p>
      <p><strong>Sexo:</strong> <%= animal.sex == "male" ? "Macho" : "Fêmea" %></p>
      <p><strong>Cidade:</strong> <%= "#{animal.city}/#{animal.state}" %></p>
      <div>
        <%= link_to "Ver Detalhes", animal_path(animal), class: "btn" %>
      </div>
    </div>
  <% end %>
</div>
