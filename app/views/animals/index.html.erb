<main class="mx-auto w-full max-w-7xl space-y-8 px-4 py-8 sm:px-6 lg:px-8">
  <section class="bg-gradient-to-r from-rose-50 to-emerald-50 dark:from-[#151C2C] dark:to-[#151C2C] p-6 sm:p-10 rounded-3xl mb-8 border border-rose-100/50 dark:border-slate-800 text-center shadow-sm dark:shadow-xl">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white mb-3">Encontre seu novo melhor amigo 🐾</h1>
    <p class="text-gray-600 dark:text-slate-300 text-base sm:text-lg max-w-2xl mx-auto">Conectamos animais resgatados a famílias amorosas. Escolha um pet e fale diretamente com o responsável pelo WhatsApp!</p>
  </section>

  <section aria-label="Filtros de animais" class="mb-6 w-full rounded-3xl border border-rose-100 bg-rose-50 p-4 shadow-sm sm:p-5 dark:border-slate-800 dark:bg-[#151C2C] dark:shadow-xl">
    <% current_species = params[:species].presence_in(Animal.species.keys) %>
    <details id="animal-filters" class="group">
      <summary class="mb-3 flex cursor-pointer list-none items-center justify-between rounded-2xl border border-rose-100 bg-rose-50 px-4 py-3 font-bold text-rose-700 marker:hidden md:hidden dark:border-rose-500/30 dark:bg-slate-800/80 dark:text-rose-300">
        🔍 Filtrar Animais <span class="text-xs font-normal">Expandir ↓</span>
      </summary>
      <nav aria-label="Filtrar por espécie" class="flex flex-wrap gap-2">
      <% [["Todos", nil], ["🐱 Gatos", "cat"], ["🐶 Cachorros", "dog"]].each do |label, species| %>
        <% selected = current_species == species || (species.nil? && current_species.blank?) %>
        <%= link_to label, animals_path(request.query_parameters.except("species").merge(species: species).compact_blank), class: "rounded-full px-4 py-2 text-sm font-semibold transition focus:outline-none focus:ring-2 focus:ring-rose-400 #{selected ? 'bg-[#E60067] text-white shadow-md shadow-pink-500/20' : 'bg-white text-rose-700 hover:bg-rose-100 dark:bg-slate-700/70 dark:text-slate-200 dark:hover:bg-slate-600'}" %>
      <% end %>
      </nav>

      <div class="mt-4 flex flex-col gap-4">
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-rose-900 dark:text-rose-200">Porte</p>
        <div class="flex flex-wrap gap-2">
          <% [["Todos", nil], ["Pequeno", "small"], ["Médio", "medium"], ["Grande", "large"]].each do |label, value| %>
            <% selected = params[:size].to_s == value.to_s && (value.present? || params[:size].blank?) %>
            <%= link_to label, animals_path(request.query_parameters.except("size").merge(value.present? ? { size: value } : {}).compact_blank), class: "inline-flex items-center rounded-full px-4 py-2 text-sm transition #{selected ? 'bg-[#E60067] text-white font-bold shadow-md shadow-pink-500/20' : 'bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-slate-700/70 dark:text-slate-200 dark:hover:bg-slate-600'}" %>
          <% end %>
        </div>
      </div>
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-rose-900 dark:text-rose-200">Sexo</p>
        <div class="flex flex-wrap gap-2">
          <% [["Todos", nil], ["♂ Macho", "male"], ["♀ Fêmea", "female"]].each do |label, value| %>
            <% current_sex = params[:gender].presence || params[:sex] %>
            <% selected = current_sex.to_s == value.to_s && (value.present? || current_sex.blank?) %>
            <% filters = request.query_parameters.except("sex", "gender") %>
            <% filters = filters.merge(sex: value) if value.present? %>
            <%= link_to label, animals_path(filters.compact_blank), class: "inline-flex items-center rounded-full px-4 py-2 text-sm transition #{selected ? 'bg-[#E60067] text-white font-bold shadow-md shadow-pink-500/20' : 'bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-slate-700/70 dark:text-slate-200 dark:hover:bg-slate-600'}" %>
          <% end %>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <%= link_to "Limpar filtros", animals_path, class: "ml-2 text-xs text-gray-500 underline" if params[:species].present? || params[:size].present? || params[:sex].present? || params[:gender].present? %>
      </div>
      </div>
    </details>
    <script>
      (() => {
        const filters = document.getElementById("animal-filters");
        const mobile = window.matchMedia("(max-width: 767px)");
        const syncFilters = () => { filters.open = !mobile.matches; };
        syncFilters();
        mobile.addEventListener("change", syncFilters);
      })();
    </script>
  </section>

  <% if @animals.any? %>
    <section aria-label="Pets disponíveis para adoção" class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% @animals.each do |animal| %>
        <%= link_to animal_path(animal), class: "group flex h-auto flex-row overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-all hover:shadow-md focus:outline-none focus:ring-4 focus:ring-rose-300 dark:border-slate-800 dark:bg-[#151C2C] dark:shadow-xl md:h-full md:flex-col" do %>
          <div class="relative flex aspect-[3/4] w-32 flex-shrink-0 items-center justify-center overflow-hidden rounded-l-2xl bg-slate-900/90 p-1 sm:w-40 md:aspect-square md:w-full md:rounded-t-2xl md:rounded-l-none dark:bg-slate-950">
            <% if animal.photos.attached? %>
              <%= image_tag animal.photos.first, alt: "Foto de #{animal.name}", class: "w-full h-full object-contain rounded-lg" %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center bg-rose-100 text-5xl text-rose-300 dark:bg-slate-700/70" aria-label="Foto não disponível">
                <span aria-hidden="true">🐾</span>
              </div>
            <% end %>

            <% if animal.created_at >= 7.days.ago %>
              <span class="absolute top-1 left-1 text-[9px] font-bold px-1.5 py-0.5 rounded bg-rose-600/90 text-white z-10 shadow-sm">Chegou agora</span>
            <% end %>

            <span class="absolute top-1 right-1 z-10 inline-flex items-center justify-center rounded-full bg-gray-500/70 p-1.5" aria-label="<%= animal.female? ? 'Fêmea' : (animal.male? ? 'Macho' : 'Sexo não informado') %>">
              <% if animal.female? %>
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/90 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="8" r="5" />
                  <path stroke-linecap="round" d="M12 13v8m-3-3h6" />
                </svg>
              <% elsif animal.male? %>
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/90 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="10" cy="14" r="6" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.5 9.5 6-6m-5 0h5v5" />
                </svg>
              <% else %>
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/90 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c-2 3-6 6.5-6 11a6 6 0 0 0 12 0c0-4.5-4-8-6-11Z" />
                </svg>
              <% end %>
            </span>
          </div>

          <div class="flex w-2/3 min-w-0 flex-col justify-between overflow-hidden p-3 sm:p-4 md:w-auto md:flex-grow">
            <div class="min-w-0">
              <h3 class="truncate text-base font-bold text-[#E60067] dark:text-white sm:text-lg"><%= animal.name %></h3>
              <p class="mb-2 mt-1 line-clamp-2 text-xs text-gray-600 dark:text-slate-300 sm:text-sm"><%= animal.description.presence || animal.temperament.presence || "Um novo amigo está esperando para conhecer você." %></p>
            </div>
            <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-2">
              <span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full border px-2.5 py-1 text-[11px] font-semibold <%= animal.cat? ? 'border-emerald-200/50 bg-emerald-50 text-emerald-700 dark:border-emerald-800/40 dark:bg-emerald-950/60 dark:text-emerald-300' : 'border-rose-200/50 bg-rose-50 text-rose-700 dark:border-rose-800/40 dark:bg-rose-950/60 dark:text-rose-300' %>"><%= animal.species == 'cat' ? '🐱 Gato' : '🐶 Cão' %></span>
              <span class="inline-flex items-center whitespace-nowrap rounded-full border border-slate-200/60 bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-700 dark:border-slate-700/60 dark:bg-slate-800 dark:text-slate-300"><%= animal.age.present? ? localized_animal_age(animal.age) : "Idade desconhecida" %></span>
              <% if animal.size.present? %>
                <span class="inline-flex items-center whitespace-nowrap rounded-full border border-slate-200/60 bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-700 dark:border-slate-700/60 dark:bg-slate-800 dark:text-slate-300"><%= { "small" => "Pequeno", "medium" => "Médio", "large" => "Grande" }[animal.size] %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <section class="mx-auto max-w-lg rounded-3xl border border-rose-100 bg-white px-6 py-12 text-center shadow-sm dark:border-gray-700/60 dark:bg-[#1E293B]">
      <p class="text-5xl" aria-hidden="true">🐾</p>
      <h2 class="mt-4 text-xl font-bold text-slate-800 dark:text-gray-100">Nenhum pet encontrado</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-300">Tente ajustar os filtros para conhecer outros animais.</p>
      <%= link_to "Limpar filtros", animals_path, class: "mt-6 inline-flex rounded-xl bg-[#E60067] px-5 py-3 font-semibold text-white transition hover:bg-[#c40057]" %>
    </section>
  <% end %>
</main>
