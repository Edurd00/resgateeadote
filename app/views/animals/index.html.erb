<main class="mx-auto w-full max-w-7xl space-y-8 px-4 py-8 sm:px-6 lg:px-8">
  <header class="flex flex-col gap-5 border-b border-rose-100 pb-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-rose-500">Um lar cheio de carinho começa aqui</p>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-800 sm:text-4xl">Encontre seu novo melhor amigo <span aria-hidden="true">🐾</span></h1>
      <p class="mt-2 text-slate-600">Conheça os pets que estão esperando por uma família.</p>
    </div>
    <%= link_to admin_animals_path, class: "inline-flex shrink-0 items-center justify-center rounded-xl border border-rose-200 bg-white px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-300 focus:ring-offset-2" do %>
      Painel administrativo
    <% end %>
  </header>

  <nav aria-label="Filtrar por espécie" class="flex flex-wrap gap-2">
    <% current_species = params[:species] %>
    <% [["Todos", nil], ["🐱 Gatos", "cat"], ["🐶 Cachorros", "dog"]].each do |label, species| %>
      <% selected = current_species == species || (species.nil? && current_species.blank?) %>
      <%= link_to label, animals_path(species: species), class: "rounded-full px-4 py-2 text-sm font-semibold transition focus:outline-none focus:ring-2 focus:ring-rose-300 #{selected ? 'bg-rose-500 text-white shadow-sm' : 'bg-rose-50 text-rose-700 hover:bg-rose-100'}" %>
    <% end %>
  </nav>

  <% if @animals.any? %>
    <section aria-label="Pets disponíveis para adoção" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% @animals.each do |animal| %>
        <article class="group flex flex-col overflow-hidden rounded-3xl border border-rose-100 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
          <div class="relative aspect-[4/3] overflow-hidden bg-amber-50">
            <% if animal.photos.attached? %>
              <%= image_tag animal.photos.first, alt: "Foto de #{animal.name}", class: "h-full w-full object-cover transition duration-300 group-hover:scale-105" %>
            <% else %>
              <div class="flex h-full flex-col items-center justify-center gap-2 text-rose-300" aria-label="Foto não disponível">
                <span class="text-5xl" aria-hidden="true">🐾</span>
                <span class="text-sm font-medium text-slate-500">Foto em breve</span>
              </div>
            <% end %>
            <span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-rose-700 shadow-sm backdrop-blur">
              <%= animal.cat? ? "🐱 Gato" : (animal.dog? ? "🐶 Cachorro" : animal.species&.titleize) %>
            </span>
          </div>

          <div class="flex flex-1 flex-col p-5">
            <h2 class="text-xl font-bold text-slate-800"><%= animal.name %></h2>
            <div class="mt-3 flex flex-wrap gap-2 text-sm text-slate-600">
              <span class="rounded-full bg-rose-50 px-3 py-1"><%= animal.male? ? "Macho" : (animal.female? ? "Fêmea" : "Sexo não informado") %></span>
              <span class="rounded-full bg-amber-50 px-3 py-1"><%= animal.age.presence || "Idade não informada" %></span>
            </div>
            <%= link_to "Conhecer", animal_path(animal), class: "mt-5 inline-flex w-full items-center justify-center rounded-xl bg-rose-500 px-4 py-3 font-semibold text-white transition hover:bg-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-300 focus:ring-offset-2" %>
          </div>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="mx-auto max-w-lg rounded-3xl border border-rose-100 bg-white px-6 py-12 text-center shadow-sm">
      <p class="text-5xl" aria-hidden="true">🐾</p>
      <h2 class="mt-4 text-xl font-bold text-slate-800">Nenhum pet encontrado</h2>
      <p class="mt-2 text-slate-600">Tente outro filtro para conhecer os animais disponíveis.</p>
      <%= link_to "Ver todos os pets", animals_path, class: "mt-6 inline-flex rounded-xl bg-rose-500 px-5 py-3 font-semibold text-white transition hover:bg-rose-600" %>
    </section>
  <% end %>
</main>
