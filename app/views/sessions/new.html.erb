<h2>Login</h2>

<% if flash[:alert] %>
  <div role="alert" class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm font-medium text-amber-900 shadow-sm"><%= flash[:alert] %></div>
<% end %>

<% if flash[:notice] %>
  <div class="alert alert-success"><%= flash[:notice] %></div>
<% end %>

<%= form_with url: login_path, method: :post, local: true do |form| %>
  <div>
    <%= form.label :email, "E-mail" %>
    <%= form.email_field :email, required: true %>
  </div>

  <div>
    <%= form.label :password, "Senha" %>
    <%= form.password_field :password, required: true %>
  </div>

  <div>
    <%= form.submit "Entrar" %>
  </div>
<% end %>
