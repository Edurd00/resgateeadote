<main class="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-12 dark:bg-gray-900">
  <section class="w-full max-w-md rounded-2xl bg-white p-8 shadow-lg dark:bg-gray-800">
    <div class="mb-8 text-center">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-rose-500">Resgate e Adote</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-gray-100">Acesso do Voluntário</h1>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">Entre para cuidar dos pets e acompanhar adoções.</p>
    </div>

    <%= form_with url: login_path, local: true, data: { turbo: false }, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :email, "E-mail", class: "block text-sm font-semibold text-gray-800 dark:text-gray-100" %>
        <%= f.email_field :email, required: true, autocomplete: "email", placeholder: "voce@exemplo.com", class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 shadow-sm placeholder:text-gray-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400" %>
      </div>

      <div>
        <%= f.label :password, "Senha", class: "block text-sm font-semibold text-gray-800 dark:text-gray-100" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password", class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 shadow-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30 dark:border-gray-600 dark:bg-gray-700 dark:text-white" %>
      </div>

      <%= f.submit "Entrar", class: "inline-flex w-full cursor-pointer items-center justify-center rounded-xl bg-[#E60067] px-4 py-3 font-bold text-white transition hover:bg-[#c40057] focus:outline-none focus:ring-4 focus:ring-rose-200" %>
    <% end %>
  </section>
</main>
