<%= form_with(model: [:admin, animal], local: true, class: "rounded-3xl border border-slate-100 bg-white p-5 shadow-sm sm:p-8") do |form| %>
  <% if animal.errors.any? %>
    <div id="error_explanation" role="alert" class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 p-5 text-rose-900">
      <h2 class="font-bold"><%= pluralize(animal.errors.count, "erro") %> impediram o salvamento deste pet:</h2>
      <ul class="mt-2 list-inside list-disc space-y-1 text-sm">
        <% animal.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-6 md:grid-cols-2">
    <div class="sm:col-span-2">
      <%= form.label :name, "Nome do pet", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_field :name, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Ex.: Mel" %>
      <p class="mt-2 text-sm text-slate-500">Use o nome pelo qual o pet já é chamado.</p>
    </div>

    <div>
      <%= form.label :species, "Espécie", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.select :species, Animal.species.keys.map { |k| [k == "cat" ? "Gato" : "Cachorro", k] }, { prompt: "Selecione a espécie" }, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30" %>
      <p class="mt-2 text-sm text-slate-500">Escolha a espécie do animal.</p>
    </div>

    <div>
      <%= form.label :age, "Idade", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_field :age, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Ex.: 2 anos" %>
      <p class="mt-2 text-sm text-slate-500">Se não souber a idade exata, informe uma estimativa.</p>
    </div>

    <div>
      <%= form.label :sex, "Sexo", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.select :sex, Animal.sexes.keys.map { |k| [k == "male" ? "Macho" : "Fêmea", k] }, { prompt: "Selecione o sexo" }, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30" %>
    </div>

    <div>
      <%= form.label :size, "Porte", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.select :size, Animal.sizes.keys.map { |k| [k == "small" ? "Pequeno" : (k == "medium" ? "Médio" : "Grande"), k] }, { prompt: "Selecione o porte" }, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30" %>
    </div>

    <div>
      <%= form.label :status, "Situação para adoção", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.select :status, Animal.statuses.keys.map { |k| [k == "available" ? "Disponível" : (k == "in_process" ? "Em processo" : "Adotado"), k] }, { prompt: "Selecione a situação" }, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30" %>
      <p class="mt-2 text-sm text-slate-500">Atualize quando o processo de adoção avançar.</p>
    </div>

    <div>
      <%= form.label :city, "Cidade", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_field :city, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Ex.: São Paulo" %>
    </div>

    <div>
      <%= form.label :state, "Estado (UF)", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_field :state, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Ex.: SP", maxlength: 2 %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :temperament, "Comportamento e personalidade", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_area :temperament, rows: 3, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Conte como ele é: brincalhão, tranquilo, carinhoso..." %>
      <p class="mt-2 text-sm text-slate-500">Descreva como o pet se comporta no dia a dia.</p>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :health_status, "Saúde e cuidados", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_area :health_status, rows: 3, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Vacinas, tratamentos ou cuidados especiais" %>
      <p class="mt-2 text-sm text-slate-500">Compartilhe informações importantes para a futura família.</p>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :description, "História do pet", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_area :description, rows: 5, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Conte um pouco sobre a história dele e o lar que procura..." %>
      <p class="mt-2 text-sm text-slate-500">Uma descrição acolhedora ajuda a encontrar a família certa.</p>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :photos, "Fotos do pet", class: "block text-sm font-semibold text-slate-800" %>
      <div class="mt-2 rounded-2xl border-2 border-dashed border-emerald-200 bg-emerald-50/50 p-5 sm:p-6">
        <%= form.file_field :photos, multiple: true, accept: "image/png,image/jpeg,image/webp", class: "block w-full cursor-pointer text-sm text-slate-600 file:mr-4 file:cursor-pointer file:rounded-xl file:border-0 file:bg-rose-500 file:px-5 file:py-3 file:text-sm file:font-semibold file:text-white hover:file:bg-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-500/30" %>
        <p class="mt-3 text-sm text-slate-600">Anexe uma ou mais fotos nítidas. São aceitos PNG, JPG e WEBP, até 5 MB por foto.</p>
      </div>
    </div>
  </div>

  <div class="mt-8 flex flex-col-reverse gap-3 border-t border-slate-100 pt-6 sm:flex-row sm:justify-end">
    <%= link_to "Cancelar", admin_animals_path, class: "inline-flex items-center justify-center rounded-xl border border-transparent bg-transparent px-6 py-3 font-semibold text-gray-600 transition hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-300" %>
    <%= form.submit "Salvar", class: "inline-flex cursor-pointer items-center justify-center rounded-xl bg-rose-500 px-7 py-3 font-bold text-white shadow-sm transition hover:bg-rose-600 focus:outline-none focus:ring-4 focus:ring-rose-200" %>
  </div>
<% end %>
