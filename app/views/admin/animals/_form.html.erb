<%= form_with(model: [:admin, animal], local: true, class: "rounded-3xl border border-slate-100 bg-white p-5 shadow-sm sm:p-8") do |form| %>
  <% if animal.errors.any? %>
    <div id="error_explanation" role="alert" class="mb-8 rounded-2xl border border-rose-200 bg-rose-50 p-5 text-rose-900">
      <h2 class="font-bold"><%= pluralize(animal.errors.count, "erro") %> impediram o salvamento deste pet:</h2>
      <ul class="mt-2 list-inside list-disc space-y-1 text-sm">
        <% animal.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-5 pb-28 md:grid md:grid-cols-2 md:gap-6 md:space-y-0 md:pb-0">
    <div class="md:col-span-2">
      <%= form.label :name, "Nome do pet", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_field :name, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Ex.: Mel" %>
      <p class="mt-2 text-sm text-slate-500">Use o nome pelo qual o pet já é chamado.</p>
    </div>

    <div>
      <%= form.label :species, "Espécie", class: "block text-sm font-semibold text-slate-800" %>
      <div class="mt-2 flex flex-wrap gap-2">
        <% [["cat", "🐱 Gato"], ["dog", "🐶 Cachorro"]].each do |value, label| %>
          <% input_id = "animal_species_#{value}" %>
          <label for="<%= input_id %>" class="cursor-pointer">
            <%= form.radio_button :species, value, id: input_id, class: "peer sr-only" %>
            <span class="inline-flex min-h-12 items-center justify-center rounded-full border border-gray-300 bg-white px-5 py-3 font-semibold text-slate-700 transition hover:border-[#E60067] peer-checked:border-[#E60067] peer-checked:bg-[#E60067] peer-checked:font-bold peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-[#E60067]"><%= label %></span>
          </label>
        <% end %>
      </div>
      <p class="mt-2 text-sm text-slate-500">Toque para escolher a espécie.</p>
    </div>

    <div>
      <%= form.label :age, "Idade", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_field :age, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Ex.: 2 anos" %>
      <p class="mt-2 text-sm text-slate-500">Se não souber a idade exata, informe uma estimativa.</p>
    </div>

    <div>
      <%= form.label :sex, "Sexo", class: "block text-sm font-semibold text-slate-800" %>
      <div class="mt-2 flex flex-wrap gap-2">
        <% [["male", "♂ Macho"], ["female", "♀ Fêmea"]].each do |value, label| %>
          <% input_id = "animal_sex_#{value}" %>
          <label for="<%= input_id %>" class="cursor-pointer">
            <%= form.radio_button :sex, value, id: input_id, class: "peer sr-only" %>
            <span class="inline-flex min-h-12 items-center justify-center rounded-full border border-gray-300 bg-white px-5 py-3 font-semibold text-slate-700 transition hover:border-[#E60067] peer-checked:border-[#E60067] peer-checked:bg-[#E60067] peer-checked:font-bold peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-[#E60067]"><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="md:col-span-2">
      <%= form.label :size, "Porte", class: "block text-sm font-semibold text-slate-800" %>
      <div class="mt-2 flex flex-wrap gap-2">
        <% [["small", "Pequeno"], ["medium", "Médio"], ["large", "Grande"]].each do |value, label| %>
          <% input_id = "animal_size_#{value}" %>
          <label for="<%= input_id %>" class="cursor-pointer">
            <%= form.radio_button :size, value, id: input_id, class: "peer sr-only" %>
            <span class="inline-flex min-h-12 items-center justify-center rounded-full border border-gray-300 bg-white px-5 py-3 font-semibold text-slate-700 transition hover:border-[#E60067] peer-checked:border-[#E60067] peer-checked:bg-[#E60067] peer-checked:font-bold peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-[#E60067]"><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div>
      <%= form.label :status, "Situação para adoção", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.select :status, Animal.statuses.keys.map { |k| [k == "available" ? "Disponível" : (k == "in_process" ? "Em processo" : "Adotado"), k] }, { prompt: "Selecione a situação" }, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30" %>
      <p class="mt-2 text-sm text-slate-500">Atualize quando o processo de adoção avançar.</p>
    </div>

    <div>
      <%= form.label :city, "Cidade", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_field :city, value: animal.city.presence || "São Paulo", class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Ex.: São Paulo" %>
      <p class="mt-2 text-sm text-slate-500">A cidade padrão é São Paulo; altere se necessário.</p>
    </div>

    <div>
      <%= form.label :state, "Estado (UF)", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_field :state, value: animal.state.presence || "SP", class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Ex.: SP", maxlength: 2 %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :temperament, "Comportamento e personalidade", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_area :temperament, rows: 3, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Conte como ele é: brincalhão, tranquilo, carinhoso e como se dá com outros animais..." %>
      <p class="mt-2 text-sm text-slate-500">Descreva como o pet se comporta no dia a dia.</p>
    </div>

    <div class="md:col-span-2">
      <%= form.label :health_status, "Saúde e cuidados", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_area :health_status, rows: 3, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Vacinas, tratamentos ou cuidados especiais" %>
      <p class="mt-2 text-sm text-slate-500">Compartilhe informações importantes para a futura família.</p>
    </div>

    <div class="md:col-span-2">
      <%= form.label :description, "História do pet", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_area :description, rows: 5, class: "mt-2 w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/30", placeholder: "Conte um pouco sobre a história do resgate, comportamento com outros animais e cuidados necessários..." %>
      <p class="mt-2 text-sm text-slate-500">Uma descrição acolhedora ajuda a encontrar a família certa.</p>
    </div>

    <div class="md:col-span-2">
      <%= form.label :photos, "Fotos do pet", class: "block text-sm font-semibold text-slate-800" %>
      <% if animal.photos.attached? %>
        <div class="mb-4 mt-3 grid grid-cols-2 gap-4 sm:grid-cols-3">
          <% animal.photos.each_with_index do |photo, index| %>
            <div class="relative aspect-square">
              <%= image_tag photo, alt: "Foto #{index + 1} do pet", class: "h-full w-full rounded-xl border border-gray-200 object-cover" %>
              <% if index.zero? %>
                <span class="absolute left-2 top-2 rounded-md bg-rose-500 px-2 py-0.5 text-xs font-bold text-white">Capa</span>
              <% end %>
              <%= link_to admin_purge_photo_path(animal, photo), class: "absolute right-2 top-2 rounded-full bg-red-600 p-1.5 text-white shadow transition hover:bg-red-700", aria: { label: "Excluir foto #{index + 1}" }, data: { turbo_method: :delete, turbo_confirm: "Deseja realmente remover esta foto?" } do %>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 7h12m-10 0 .7 13h6.6L16 7M9 7V4h6v3m-5 4v5m4-5v5" />
                </svg>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if animal.photos.count < 3 %>
        <div class="mt-2 rounded-2xl border-2 border-dashed border-gray-300 bg-gray-50 p-6 text-center transition hover:border-rose-400">
          <%= form.file_field :photos, id: "animal_photos", multiple: true, accept: "image/png,image/jpeg,image/webp", class: "sr-only" %>
          <label for="animal_photos" class="flex cursor-pointer flex-col items-center rounded-xl p-2 focus-within:ring-2 focus-within:ring-rose-500">
            <svg class="mb-3 h-10 w-10 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8.5A2.5 2.5 0 0 1 5.5 6h2l1.2-1.5h6.6L16.5 6h2A2.5 2.5 0 0 1 21 8.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-9Z" />
              <circle cx="12" cy="12.5" r="3.5" stroke-width="1.8" />
            </svg>
            <span class="font-bold text-slate-800">Clique aqui para enviar até 3 fotos</span>
            <span class="mt-1 text-sm text-gray-500">Prefira fotos bem iluminadas. A primeira será a capa.</span>
            <span class="mt-1 text-xs text-gray-500">PNG, JPG ou WEBP, até 5 MB por foto.</span>
          </label>
        </div>
      <% else %>
        <p class="rounded-xl bg-gray-50 p-4 text-sm text-gray-600">Limite de 3 fotos atingido. Remova uma foto para adicionar outra.</p>
      <% end %>
      <p class="mt-3 text-sm text-gray-500">A primeira foto da galeria será utilizada automaticamente como capa nas buscas.</p>
    </div>
  </div>

  <div class="fixed inset-x-0 bottom-0 z-20 flex gap-3 border-t border-slate-200 bg-white p-4 pb-[calc(1rem+env(safe-area-inset-bottom))] shadow-[0_-4px_16px_rgba(15,23,42,0.08)] md:static md:mt-8 md:justify-end md:border-t md:bg-transparent md:p-0 md:pb-0 md:pt-6 md:shadow-none">
    <%= link_to "Cancelar", admin_animals_path, class: "inline-flex min-h-12 flex-1 items-center justify-center rounded-xl border border-gray-300 bg-white px-5 py-3 font-semibold text-gray-600 transition hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-300 md:flex-none" %>
    <%= form.submit "Salvar Pet", class: "inline-flex min-h-12 flex-1 cursor-pointer items-center justify-center rounded-xl bg-[#E60067] px-6 py-3 font-bold text-white shadow-sm transition hover:bg-[#c40057] focus:outline-none focus:ring-4 focus:ring-rose-200 md:flex-none" %>
  </div>
<% end %>
