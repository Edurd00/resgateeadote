<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <header class="mb-8 flex flex-col items-stretch gap-4 md:flex-row md:items-center md:justify-between">
    <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">Painel de Gerenciamento de Animais</h1>
    <%= link_to "Novo Pet", new_admin_animal_path, class: "inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-[#E60067] px-5 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-[#c40057] md:w-auto" %>
  </header>

  <% if @animals.empty? %>
    <div class="rounded-xl border border-gray-200 bg-white px-6 py-10 text-center text-gray-500 shadow-sm">
      Nenhum pet cadastrado ainda.
    </div>
  <% else %>
    <section class="space-y-4 md:hidden" aria-label="Pets cadastrados">
      <% @animals.each do |animal| %>
        <% status_label, status_classes = case animal.status
           when "available" then ["Disponível", "bg-[#00A884]/10 text-[#00A884]"]
           when "in_process" then ["Em processo", "bg-[#E60067]/10 text-[#E60067]"]
           when "adopted" then ["Adotado", "bg-gray-100 text-gray-700"]
           else [animal.status, "bg-gray-100 text-gray-700"]
           end %>
        <article class="flex gap-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <% if animal.photos.attached? %>
            <%= image_tag animal.photos.first, alt: "Foto de #{animal.name}", class: "h-24 w-24 flex-shrink-0 rounded-lg object-cover" %>
          <% else %>
            <div class="flex h-24 w-24 flex-shrink-0 items-center justify-center rounded-lg bg-gray-100 text-center text-xs text-gray-500">Sem foto</div>
          <% end %>

          <div class="flex min-w-0 flex-1 flex-col justify-between gap-3">
            <div class="min-w-0">
              <h2 class="truncate text-lg font-bold text-gray-900"><%= animal.name.presence || "Pet sem nome" %></h2>
              <span class="mt-1 inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= status_classes %>"><%= status_label %></span>
              <span class="mt-1 inline-flex rounded-full px-2 py-0.5 text-xs font-medium <%= animal.cat? ? 'bg-[#00A884]/10 text-[#00A884]' : (animal.dog? ? 'bg-[#E60067]/10 text-[#E60067]' : 'bg-gray-100 text-gray-600') %>"><%= animal.cat? ? "Gato" : (animal.dog? ? "Cachorro" : "Espécie não informada") %></span>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <%= link_to "Editar", edit_admin_animal_path(animal), class: "inline-flex min-h-11 items-center justify-center rounded-lg bg-blue-50 px-3 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-100" %>
              <%= link_to "Excluir", admin_animal_path(animal), class: "inline-flex min-h-11 items-center justify-center rounded-lg bg-red-50 px-3 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-100", data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir este pet?" } %>
            </div>
          </div>
        </article>
      <% end %>
    </section>

    <div class="hidden overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm md:block">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Foto</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Nome</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Espécie</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Local</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @animals.each do |animal| %>
              <% status_label, status_classes = case animal.status
                 when "available" then ["Disponível", "bg-[#00A884]/10 text-[#00A884]"]
                 when "in_process" then ["Em processo", "bg-[#E60067]/10 text-[#E60067]"]
                 when "adopted" then ["Adotado", "bg-gray-100 text-gray-700"]
                 else [animal.status, "bg-gray-100 text-gray-700"]
                 end %>
              <tr class="transition-colors hover:bg-gray-50">
                <td class="whitespace-nowrap px-6 py-4">
                  <% if animal.photos.attached? %>
                    <%= image_tag animal.photos.first, alt: "Foto de #{animal.name}", class: "h-12 w-12 rounded-md object-cover" %>
                  <% else %>
                    <span class="flex h-12 w-12 items-center justify-center rounded-md bg-gray-100 text-xs text-gray-500">Sem foto</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 font-semibold text-gray-800"><%= animal.name.presence || "Pet sem nome" %></td>
                <td class="whitespace-nowrap px-6 py-4 text-sm">
                  <span class="rounded-full px-2 py-1 text-xs font-medium <%= animal.cat? ? 'bg-[#00A884]/10 text-[#00A884]' : (animal.dog? ? 'bg-[#E60067]/10 text-[#E60067]' : 'bg-gray-100 text-gray-600') %>"><%= animal.cat? ? "Gato" : (animal.dog? ? "Cachorro" : "Não informada") %></span>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm">
                  <span class="rounded-full px-2 py-1 text-xs font-semibold <%= status_classes %>"><%= status_label %></span>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600"><%= [animal.city, animal.state].compact_blank.join("/") %></td>
                <td class="whitespace-nowrap px-6 py-4 text-sm">
                  <div class="flex items-center gap-3">
                    <%= link_to "Editar", edit_admin_animal_path(animal), class: "font-medium text-blue-600 hover:text-blue-800" %>
                    <%= link_to "Ver", animal_path(animal), class: "font-medium text-gray-600 hover:text-gray-900" %>
                    <%= link_to "Excluir", admin_animal_path(animal), class: "font-medium text-red-600 hover:text-red-800", data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir este pet?" } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
