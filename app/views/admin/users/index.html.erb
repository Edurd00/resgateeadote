<main class="mx-auto w-full max-w-5xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-rose-500">Painel Superadmin</p>
      <h1 class="mt-1 text-3xl font-bold text-slate-900">Voluntários</h1>
      <p class="mt-2 text-slate-600">Gerencie as contas com acesso administrativo.</p>
    </div>
    <%= link_to "Novo Voluntário", new_admin_user_path, class: "inline-flex items-center justify-center rounded-xl bg-[#E60067] px-5 py-3 font-semibold text-white transition hover:bg-[#c40057] focus:outline-none focus:ring-4 focus:ring-rose-200" %>
  </header>

  <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
    <ul class="divide-y divide-slate-100">
      <% @users.each do |user| %>
        <li class="flex flex-col gap-2 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <span class="font-semibold text-slate-800"><%= user.email %></span>
          <span class="w-fit rounded-full bg-rose-50 px-3 py-1 text-sm font-medium text-rose-700"><%= user.superadmin? ? "Superadmin" : "Admin / Voluntário" %></span>
        </li>
      <% end %>
    </ul>
    <% if @users.empty? %>
      <p class="px-5 py-8 text-center text-slate-600">Ainda não há usuários cadastrados.</p>
    <% end %>
  </div>
</main>
